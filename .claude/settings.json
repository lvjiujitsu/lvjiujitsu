{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "WebSearch",
      "WebFetch",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(rg *)",
      "Bash(.\\.venv\\Scripts\\python.exe manage.py check *)",
      "Bash(.\\.venv\\Scripts\\python.exe manage.py showmigrations *)",
      "Bash(.\\.venv\\Scripts\\python.exe manage.py runserver *)"
    ],
    "ask": [
      "Bash(*manage.py test*)",
      "Bash(*manage.py shell*)",
      "Bash(*manage.py collectstatic*)",
      "Bash(*pip install*)",
      "Bash(stripe *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.hg)",
      "Read(./.env.prod)",
      "Bash(*manage.py makemigrations*)",
      "Bash(*manage.py migrate*)",
      "Bash(*clear_migrations.py*)",
      "Bash(*clear_migration_supabase_*)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git checkout -- *)",
      "Bash(pip install --user *)"
    ]
  },
  "env": {
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUTF8": "1"
  }
}
